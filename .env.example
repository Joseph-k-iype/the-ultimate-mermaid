# PatternViz Configuration
# Copy this file to backend/.env and edit as needed.
# All variables are prefixed with PATTERNVIZ_.

# ── Server ────────────────────────────────────────────────────────────
PATTERNVIZ_HOST=0.0.0.0
PATTERNVIZ_PORT=8000
PATTERNVIZ_CORS_ORIGINS=["http://localhost:5173"]

# ── Repository Cloning ────────────────────────────────────────────────
PATTERNVIZ_CLONE_DIR=/tmp/patternviz

# ── Enterprise Proxy (Optional) ──────────────────────────────────────
# PATTERNVIZ_HTTP_PROXY=http://proxy.corp.example.com:8080
# PATTERNVIZ_HTTPS_PROXY=http://proxy.corp.example.com:8080
# PATTERNVIZ_NO_PROXY=localhost,127.0.0.1
# PATTERNVIZ_USE_SYSTEM_SSL=true

# ── FalkorDB Knowledge Graph (Optional) ──────────────────────────────
PATTERNVIZ_FALKORDB_ENABLED=true
PATTERNVIZ_FALKORDB_HOST=localhost
PATTERNVIZ_FALKORDB_PORT=6379
PATTERNVIZ_FALKORDB_GRAPH=patternviz
